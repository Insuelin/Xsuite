{
  "name": "xsuite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "X 账号管理套件 — 本地快照、筛选、人工审批、限速执行",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:init": "node src/core/db/init.ts",
    "db:check": "node scripts/db-check.ts",
    "phase1": "node scripts/phase1-check.ts",
    "scrape": "node scripts/scrape-run.ts",
    "queue": "node scripts/queue.ts",
    "act": "node scripts/action-run.ts",
    "serve": "node src/server/index.ts",
    "ui:dev": "vite",
    "ui:build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "playwright-core": "^1.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
